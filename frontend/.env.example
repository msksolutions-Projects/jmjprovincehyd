# Application identity
VITE_APP_NAME=JMJ Hyderabad Province

# Public origin, used for canonical URLs, Open Graph tags and JSON-LD
VITE_SITE_URL=http://localhost:5173

# Express API base URL (the MERN backend)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Serve mock responses instead of calling the API.
# Set to "false" once the backend is running.
VITE_USE_MOCK_API=true
